APP_ENV=development
DATABASE_URL=postgresql+psycopg://bau:SUBSTITUA_PELA_SENHA_LOCAL@localhost:5432/bau
POSTGRES_PASSWORD=SUBSTITUA_PELA_SENHA_LOCAL
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_DE_48_BYTES
SESSION_MINUTES=120
# false APENAS no HTTP local. Produção exige HTTPS e true.
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:5175","http://127.0.0.1:5175"]
# Opcional: caminho absoluto para o JSON original. No Docker já é configurado.
# CATALOG_PATH=C:/Users/User/bau-das-lendas/public/lendas-ra.json
# Limites temporários por processo; produção inicial exige um único worker.
RATE_LOGIN_LIMIT=20
RATE_REGISTER_LIMIT=10
RATE_DRAW_LIMIT=120
RATE_WINDOW_SECONDS=60
RATE_LOGIN_FAILURE_LIMIT=8
RATE_LOGIN_FAILURE_WINDOW_SECONDS=300
